# ============================================
# Forge Admin UI 前端 Dockerfile
# ============================================
# 构建上下文为项目根目录，docker compose 中 context 设为 ..
FROM node:23-alpine AS admin-builder
WORKDIR /app
COPY forge-admin-ui/package.json forge-admin-ui/pnpm-lock.yaml forge-admin-ui/pnpm-workspace.yaml ./
# BuildKit cache mount：持久缓存 npm 缓存与 pnpm store，lockfile 未变时不再重复拉取依赖。
RUN --mount=type=cache,target=/root/.npm,sharing=locked \
    --mount=type=cache,target=/pnpm-store,sharing=locked \
    npm install -g pnpm@10.34.5 && pnpm install --frozen-lockfile --store-dir=/pnpm-store
COPY forge-admin-ui/ ./
RUN pnpm run build

FROM node:23-alpine AS h5-builder
WORKDIR /app
COPY forge-h5-ui/package.json forge-h5-ui/pnpm-lock.yaml forge-h5-ui/pnpm-workspace.yaml ./
RUN --mount=type=cache,target=/root/.npm,sharing=locked \
    --mount=type=cache,target=/pnpm-store,sharing=locked \
    npm install -g pnpm@10.34.5 && pnpm install --frozen-lockfile --store-dir=/pnpm-store
COPY forge-h5-ui/ ./
# 源码验证按本次改动独立执行；此处只生成唯一正式 H5 生产产物。
RUN pnpm run build:h5

FROM nginx:1.25-alpine
COPY --from=admin-builder /app/dist /usr/share/nginx/html/forge
COPY --from=h5-builder /app/dist/build/h5 /usr/share/nginx/html/forge-h5
COPY docker-forge-admin/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
