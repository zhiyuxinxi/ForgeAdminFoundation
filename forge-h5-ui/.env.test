# 测试环境配置
# 与生产一致，避免 uni-app image 组件重复拼接 H5 子路径。
VITE_PUBLIC_PATH=./

# 路由前缀
VITE_BASE_URL=/forge-h5

# map文件
VITE_DEVTOOL=none

# 请求地址前缀
VITE_REQUEST_PREFIX=/forge-h5-api

# App 服务代理地址（测试环境由 Nginx 代理，此处留空）
VITE_HTTP_PROXY_TARGET=

# 客户端配置
VITE_USER_CLIENT=h5
VITE_APP_ID=forge_h5

# 企业微信工作台免登：已改为后端连接配置控制（sys_social_config.sso_workbench_enabled + connection_code），前端无需再配置
