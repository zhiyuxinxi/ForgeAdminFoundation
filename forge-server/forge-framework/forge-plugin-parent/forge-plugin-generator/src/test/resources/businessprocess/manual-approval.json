  "nodes": [
    {
      "id": "start_manual",
      "type": "START_MANUAL",
      "name": "提交审批",
      "config": {
        "positions": ["ROW", "DETAIL"],
        "permission": "ai:businessProcess:start",
        "confirmText": "确认提交当前采购单审批？",
