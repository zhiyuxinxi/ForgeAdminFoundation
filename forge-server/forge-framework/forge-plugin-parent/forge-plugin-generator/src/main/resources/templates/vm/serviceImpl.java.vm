    private void validateReferences(Object dto, Object id, String operation) {
        LowcodeRuntimeConfig config = referenceConfig();
        Map<String, Object> values = identityJson.convertValue(dto,
                new com.fasterxml.jackson.core.type.TypeReference<Map<String, Object>>() { });
        // Generated MyBatis DTO updates ignore null properties; omitted fields retain the stored value.
        values.values().removeIf(java.util.Objects::isNull);
        if (!new RuntimeIdentityFields(identityJson).hasPayload(config, values)) {
            return;
        }
        new RuntimeIdentityScope(identityDataScopes).authorize(config, operation);
        Map<String, Object> previous = null;
        if ("edit".equals(operation)) {
            var scope = identityDataScopes.getCurrentUserDataScope(config.getReferencePermissionModule());
            var condition = identityRowScopes.buildRuntimeCondition(config, "${tableName}", null, scope);
            previous = identityRecords.selectById("${tableName}", "${pkColumn.columnName}", id, condition);
            if (previous == null || previous.isEmpty()) {
                throw new BusinessException(403, UiMessages.label("无权限更新该数据或数据不存在", "The record is missing or outside the business scope"));
            }
        }
        identityReferences.validateWrite(config, values, previous, operation);
    }
#end

#if(${enableServiceExtensions})
    private <T> T invokeExtensions(
            Function<${className}ServiceExtension,
                    Function<${className}ServiceExtension.Operation<T>,
                            ${className}ServiceExtension.Operation<T>>> wrapperFactory,
            ${className}ServiceExtension.Operation<T> terminal) {
        ${className}ServiceExtension.Operation<T> chain = terminal;
        List<${className}ServiceExtension> extensions = extensionProvider.orderedStream().toList();
        for (int index = extensions.size() - 1; index >= 0; index--) {
            ${className}ServiceExtension.Operation<T> next = chain;
            chain = wrapperFactory.apply(extensions.get(index)).apply(next);
        }
        return chain.proceed();
    }

#end

#if(${hasTreeConfig})
    private List<${tree.className}> build${tree.className}Tree(List<${tree.className}> rows) {
        Map<String, ${tree.className}> nodeMap = new LinkedHashMap<>();
        for (${tree.className} row : rows) {
            String key = normalizeTreeKey(row.get${tree.keyFieldCap}());
            if (StringUtils.isBlank(key)) {
                continue;
            }
            row.set${tree.childrenFieldCap}(new ArrayList<>());
            nodeMap.put(key, row);
        }

        List<${tree.className}> roots = new ArrayList<>();
        for (${tree.className} row : nodeMap.values()) {
            String key = normalizeTreeKey(row.get${tree.keyFieldCap}());
            String parentKey = normalizeTreeKey(row.get${tree.parentFieldCap}());
            ${tree.className} parent = nodeMap.get(parentKey);
            if (isRootTreeParent(parentKey) || parent == null || key.equals(parentKey)) {
                roots.add(row);
                continue;
            }
            parent.get${tree.childrenFieldCap}().add(row);
        }
        normalize${tree.className}TreeLeafState(roots);
        return roots;
    }

    private void normalize${tree.className}TreeLeafState(List<${tree.className}> nodes) {
        for (${tree.className} node : nodes) {
            List<${tree.className}> children = node.get${tree.childrenFieldCap}();
            if (children != null && !children.isEmpty()) {
                node.setIsLeaf(false);
                normalize${tree.className}TreeLeafState(children);
            } else {
                node.setIsLeaf(true);
            }
        }
    }

    private boolean isRootTreeParent(String parentKey) {
        return StringUtils.isBlank(parentKey) || "0".equals(parentKey) || "null".equalsIgnoreCase(parentKey);
    }

    private String normalizeTreeKey(Object value) {
        if (value == null) {
            return null;
        }
        String key = String.valueOf(value);
        return StringUtils.isBlank(key) ? null : key;
    }

#end
#if(${isMasterDetailLayout})
    private List<Map<String, Object>> resolveChildRows(${className}MasterDetailDTO dto, String childKey) {
        if (dto == null || dto.getChildren() == null || dto.getChildren().get(childKey) == null) {
            return List.of();
        }
        return dto.getChildren().get(childKey);
    }

#foreach($child in $masterDetailChildren)
    private Object resolve${child.className}RelationValue(${className} main, Object fallbackId) {
        Object value = main == null ? null : main.get${child.mainFieldCap}();
        return value == null ? fallbackId : value;
    }

    private void clear${child.className}Rows(Object relationValue) {
        if (relationValue == null) {
            return;
        }
        ${classname}Mapper.clear${child.className}Rows(relationValue);
    }

    private void save${child.className}Rows(List<Map<String, Object>> rows, Object relationValue) {
        if (relationValue == null || rows == null || rows.isEmpty()) {
            return;
        }
        for (Map<String, Object> row : rows) {
            ${child.className}DTO childDto = BeanUtil.toBean(row, ${child.className}DTO.class);
#if($child.pkColumn)
            BeanUtil.setProperty(childDto, "${child.pkColumn.javaField}", null);
#end
            BeanUtil.setProperty(childDto, "${child.childFkField}", relationValue);
            var violations = validator.validate(childDto, ${child.className}DTO.Create.class);
            if (!violations.isEmpty()) {
                throw new ConstraintViolationException(violations);
            }
            ${child.className} entity = BeanUtil.toBean(childDto, ${child.className}.class);
#if($child.pkColumn)
            BeanUtil.setProperty(entity, "${child.pkColumn.javaField}", null);
#end
            BeanUtil.setProperty(entity, "${child.childFkField}", relationValue);
            if (${child.mapperVarName}.insert(entity) != 1) {
                throw new BusinessException(UiMessages.message("operation.failed"));
            }
        }
    }

#end
#end
