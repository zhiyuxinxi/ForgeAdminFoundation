    @Override
    @Transactional(rollbackFor = Exception.class)
    public boolean import${className}(List<${className}DTO> rows) {
#if(${enableServiceExtensions})
        return invokeExtensions(
                extension -> next -> () -> extension.aroundImport(rows, next),
                () -> {
#end
        if (rows == null || rows.isEmpty()) {
            return true;
        }
        for (${className}DTO row : rows) {
            var violations = validator.validate(row, ${className}DTO.Create.class);
            if (!violations.isEmpty()) {
                throw new ConstraintViolationException(violations);
            }
#if(${isMasterDetailLayout})
            ${className}MasterDetailDTO aggregate = new ${className}MasterDetailDTO();
            aggregate.setMain(row);
            if (!insert${className}(aggregate)) {
#else
            if (!insert${className}(row)) {
#end
                throw new BusinessException(UiMessages.message("codegen.importFailure",
                        UiMessages.label($i18n.javaLiteral($functionName), $i18n.javaLiteral($functionNameEn))));
            }
        }
        return true;
#if(${enableServiceExtensions})
                });
#end
