#if(${hasIdentityReferences})
    private LowcodeRuntimeConfig referenceConfig() {
        LowcodeRuntimeConfig config = new LowcodeRuntimeConfig();
        var caller = SessionHelper.getLoginUser();
        config.setTenantId(caller == null ? null : caller.getTenantId());
        config.setConfigKey("${runtimeConfigKey}");
        config.setTableName("${tableName}");
        config.setBuildMode("LOWCODE");
        config.setObjectCode(${identityObjectLiteral});
        config.setModelSchema(${identityModelLiteral});
        config.setEditSchema(${identityEditLiteral});
        config.setReferencePermissionModule("${moduleName}:${businessName}");
        return config;
    }

