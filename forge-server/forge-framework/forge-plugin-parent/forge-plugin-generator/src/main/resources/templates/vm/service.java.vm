    List<TenantMember> referenceMembers(String field, String operation, Long directOrgId, String keyword, Long afterUserId, int limit);
    List<TenantPost> referencePosts(String field, String operation, Long directOrgId, boolean tenantWide, String keyword, Long afterPostId, int limit);
    RuntimeIdentityReferenceService.PostScope referencePostScope(String field, String operation);
#end

    /**
     * 分页查询${functionName}列表
     */
    Page<${className}> select${className}Page(PageQuery pageQuery, ${className}Query query);

    /**
     * 查询${functionName}列表
     */
    List<${className}> select${className}List(${className}Query query);

#if(${hasTreeConfig})
    /**
     * 查询${functionName}树形数据
     */
    List<${tree.className}> select${tree.className}Tree(String loadMode, String parentValue);

#end
    /**
