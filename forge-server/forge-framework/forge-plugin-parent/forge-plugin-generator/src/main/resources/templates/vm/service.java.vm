     */
    boolean delete${className}ById(${pkColumn.javaType} ${pkColumn.javaField});

    /**
     * 批量删除${functionName}
     */
    boolean delete${className}ByIds(${pkColumn.javaType}[] ${pkColumn.javaField}s);

    /**
     * 批量导入${functionName}。导入解析在 Controller 完成，持久化与业务扩展在本事务入口执行。
     */
    boolean import${className}(List<${className}DTO> rows);
