<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mdframe.forge.plugin.ai.chat.mapper.AiChatMessageToolCallMapper">

    <resultMap id="toolCallResultMap" type="com.mdframe.forge.plugin.ai.chat.domain.AiChatMessageToolCall">
        <id property="id" column="id"/>
        <result property="tenantId" column="tenant_id"/>
        <result property="recordId" column="record_id"/>
        <result property="sessionId" column="session_id"/>
        <result property="seq" column="seq"/>
        <result property="toolName" column="tool_name"/>
        <result property="toolArgsJson" column="tool_args_json"/>
        <result property="toolResultJson" column="tool_result_json"/>
        <result property="status" column="status"/>
        <result property="errorMsg" column="error_msg"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <select id="selectBySessionId" resultMap="toolCallResultMap">
        SELECT id, tenant_id, record_id, session_id, seq, tool_name,
               tool_args_json, tool_result_json, status, error_msg,
               create_time, update_time
        FROM ai_chat_message_tool_call
        WHERE session_id = #{sessionId}
          AND del_flag = 0
        ORDER BY record_id ASC, seq ASC, id ASC
    </select>

    <select id="selectByRecordId" resultMap="toolCallResultMap">
        SELECT id, tenant_id, record_id, session_id, seq, tool_name,
               tool_args_json, tool_result_json, status, error_msg,
               create_time, update_time
        FROM ai_chat_message_tool_call
        WHERE record_id = #{recordId}
          AND del_flag = 0
        ORDER BY seq ASC, id ASC
    </select>

</mapper>
